        <http://openvivo.org/a/n20744>,
        <http://openvivo.org/a/n31605>,
        <http://openvivo.org/a/n41372> .

<http://openvivo.org/a/doi10.4172/2155-9600.1000414> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:AcademicArticle,

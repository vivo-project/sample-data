    rdfs:label "SAMURAI’s sword: VIVO as a linked-data extension to a home-built researchers directory service" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.5260477-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventVIVO2017> ;
    ns3:abstract "SAMURAI (http://samurai.nims.go.jp) is a researcher directory service served by National Institute for Materials Science (NIMS). It is designed for researchers and engineers in NIMS to introduce their research activities and achievements more effectively.<br><br>SAMURAI has several unique features such as ORCID integration (synchronize publication lists between SAMURAI and ORCID) and displaying article information (number of citations and Altmetric.com badge). For a further<br>development to share and reuse research information in SAMURAI and other research network systems, we chose VIVO as a backend application to implement Linked Data and co-author network visualizations.<br><br>In this presentation, we cover the following topics:<br>- How SAMURAI collect and aggregate researchers’ profile and publication information from internal and external sources<br>- How to prepare researchers’ profile and bibliographic data and import them from SAMURAI to VIVO<br>- A live demonstration of the prototype" ;
    ns3:doi "10.6084/m9.figshare.5260477" ;
    ns3:freetextKeyword "SAMURAI",
        "VIVO",
        "vivo17" ;
    ns2:mostSpecificType ns1:ConferencePoster ;
    ns1:dateCreated <http://openvivo.org/a/date2017-07-31>,
        <http://openvivo.org/a/date2017-08-07> ;
    ns1:dateModified <http://openvivo.org/a/date2017-07-31>,
        <http://openvivo.org/a/date2017-08-07> ;
    ns1:datePublished <http://openvivo.org/a/date2017-07-31>,
        <http://openvivo.org/a/date2017-08-07> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2017-07-31>,
        <http://openvivo.org/a/date2017-08-07> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.5260477-authorship1> .


    rdfs:label "OpenVIVO: A VIVO anyone can join" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3175072-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "OpenVIVO is a hosted open VIVO that anyone can join.  Supporting sign on via ORCiD and data from ORCiD, Figshare, Grid, CrossRef, NLM, Force16 and user entry.  OpenVIVO demonstrates a connected, identified ecosystem of people, works and organizations" ;

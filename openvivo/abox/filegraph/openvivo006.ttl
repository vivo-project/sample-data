    ns1:freetextKeyword "Grey literature"^^xsd:string,
        "Information management"^^xsd:string,
        "Public policy"^^xsd:string ;
    ns1:hasResearchArea <http://id.worldcat.org/fast/947852> ;
    ns1:orcidId <http://orcid.org/0000-0003-2194-8178> ;
    ns1:overview "Amanda Lawrence has been working in library and information management for the last 10 years as Managing Editor and more recently Research and Strategy Manager with APO digital library (apo.org.au). In 2012 she began working on an Australian Research Council Linkage research project, Grey Literature Strategies, looking at the role and value of online research publishing for public policy and practice. She is currently working on a PhD on this same topic. Amanda has a Graduate Diploma in Library and Information Management from RMIT University and an Arts Degree with Honours in Literature and Social Theory from the University of Melbourne. Before moving into the library sector she worked in the book and publishing sector as Literature Program Manager at the Asialink Centre, Programming manager at the Victorian Writers Centre and bookseller and editor at Readings Bookstore."^^xsd:string ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3172927-authorship1>,

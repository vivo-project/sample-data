    ns3:abstract """<div>
			<div>
				<div>
					<div>
						<p>SOPHIA builds altmetric networks of
researchers and institutions
</p>
						<ul>
							<li>
								<p>•   to develop our understanding of how
research outcomes are propagated in the
society
</p>
							</li>
							<li>
								<p>•   to experiment with metrics that quantify
the authority, centrality and influence of
researchers / institutions for a given topic </p>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>""" ;

        <http://openvivo.org/a/n49097>,
        <http://openvivo.org/a/n50737>,
        <http://openvivo.org/a/n77223> .

<http://openvivo.org/a/doi10.11648/j.abb.20170502.11> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:AcademicArticle,

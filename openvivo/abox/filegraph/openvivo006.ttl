    ns1:hasPublicationVenue <http://openvivo.org/a/jou.2330-8818> ;
    ns1:relatedBy <http://openvivo.org/a/n126559>,
        <http://openvivo.org/a/n204011>,
        <http://openvivo.org/a/n26438>,
        <http://openvivo.org/a/n85274> .

<http://openvivo.org/a/doi10.11648/j.ajbls.20170502.11> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,

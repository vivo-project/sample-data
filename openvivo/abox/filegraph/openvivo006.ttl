<http://openvivo.org/a/doi10.6084/m9.figshare.3175168> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "What kinds of research are cited quickly in policy documents? Results from an exploratory study" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3175168-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "This exploratory study set out to determine the citation lag for articles indexed in Altmetric Explorer that have been cited at least once in public policy documents. Articles identified as having a large volume of online attention (n=116) are compared to a random sample of articles that have any online attention (n=116) to understand if articles with greater overall online exposure might be cited any earlier than other articles. Attention as it occurs in specific Altmetric score-dependent sources like Twitter and mainstream media is examined, and Mendeley reader counts, which do not factor into the Altmetric score, are also compared across the two samples to identify differences. Document characteristics such as assignment of PubMed ID and Web of Knowledge-identified Research Domain and Document Type are also compared." ;
    ns3:doi "10.6084/m9.figshare.3175168" ;
    ns3:freetextKeyword "Force16",
        "altmetrics",
        "citations",
        "public policy" ;
    ns2:mostSpecificType ns1:ConferencePoster ;
    ns1:dateCreated <http://openvivo.org/a/date2016-04-13> ;
    ns1:dateModified <http://openvivo.org/a/date2016-04-13> ;
    ns1:datePublished <http://openvivo.org/a/date2016-04-13> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-04-13> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3175168-authorship1> .

<http://openvivo.org/a/doi10.6084/m9.figshare.3175534.v1> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "M_Cassidy_and_L_Walter_rimes poster_Force2016_Final_Version.pdf" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3175534.v1-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract """At the University of
British Columbia, Okanagan campus, the Library and the Centre for Scholarly Communication
recently partnered with the Office of Research Services in order to
collaboratively build a research portal for faculty. Research and
Infrastructure Management Enterprise Services (rimes) was created as a seamless
portal for researchers on campus to access resources, services, and tools for
planning, conducting, communicating, sharing, and measuring their research.
Traditionally, support for the scholarly lifecycle has been dispersed among
various units on campus and has not taken into consideration changes in the
scholarly communication landscape. For researchers to meet mandates for open
access, data management, knowledge transfer, and research impact,
collaborations among on-campus units are necessary for providing faculty
support from a coordinated perspective. The main benefits of the Library,
Centre for Scholarly Communication, and Office of Research Services partnership
are improved knowledge creation and sharing. This session will demonstrate the
rimes portal and associated tools, as well as present a poster on the genesis,
implementation, and outcomes of the project.""" ;
    ns3:doi "10.6084/m9.figshare.3175534.v1" ;
    ns3:freetextKeyword "FORCE11",
        "FORCE2016",
        "University of British Columbia Okanagan",
        "rimes" ;
    ns2:mostSpecificType ns1:ConferencePoster ;
    ns1:dateCreated <http://openvivo.org/a/date2016-04-13> ;
    ns1:dateModified <http://openvivo.org/a/date2016-04-13> ;
    ns1:datePublished <http://openvivo.org/a/date2016-04-13> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-04-13> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3175534.v1-authorship1> .

<http://openvivo.org/a/doi10.6084/m9.figshare.3179272> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "Bringing to light high quality scholarly discussions: Why is it so difficult?" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3179272-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "Scholars are natural annotators and commenters. However, most of them do not practice online annotation and commenting in their everyday research activities. This poster (presented in FORCE 2016) identifies the main challenges for the widespread adoption of online annotation and commenting and indicates how Grove, a new product by RedLink (redlink.com), strives to overcome them. Grove will be a scholarly commenting platform and a social network for researchers and qualified practitioners." ;
    ns3:doi "10.6084/m9.figshare.3179272" ;
    ns3:freetextKeyword "FORCE16",
        "Grove",
        "RedLink",
        "academic social network",
        "online annotation",
        "post publication peer review",
        "scholarly comments",
        "scholarly publishing" ;

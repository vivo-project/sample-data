    rdfs:label "CONDESAN: An Innovative and Multi-institutional Andean Platform in Continuing Evolution" ;
    ns5:ARG_2000028 <http://openvivo.org/a/n3623> ;
    ns3:doi "10.1659/mrd.mp013" ;
    ns3:issue "4" ;
    ns3:numPages "2"^^xsd:long ;
    ns3:pageEnd "358" ;
    ns3:pageStart "356" ;

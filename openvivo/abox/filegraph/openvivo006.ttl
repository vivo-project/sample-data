<http://openvivo.org/a/n30535> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "VIVO Lab at the German National Library of Science and Technology: Review and Outlook"^^xsd:string ;
    ns5:ARG_2000028 <http://openvivo.org/a/n31445> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventVIVO2016> ;
    ns3:abstract "This poster gives an overview about past, current and future activities of the VIVO Lab &ndash; a sub-group of the Open Science Lab at the German National Library of Science and Technology (TIB). &nbsp;In the past there have been several corporate projects and implementations around VIVO, including the past corporate VIVO project &ndash; VIVO for the TIB, which was complemented with the additional features (VIVOPath and VIVO Deutsches Handbuch). The current subject area of the VIVO Lab covers, among other things, the alignment of the Research Core Dataset (KDSF) to the VIVO-ISF and the integration of the national standard into VIVO, which&nbsp; is planned to be applied as a new model of the TIB VIVO for internal assessment and reporting." ;
    ns2:mostSpecificType ns1:ConferencePoster ;
    ns1:relatedBy <http://openvivo.org/a/n31815>,
        <http://openvivo.org/a/n54905>,
        <http://openvivo.org/a/n62187> .


        <http://openvivo.org/a/n28252>,
        <http://openvivo.org/a/n32358>,
        <http://openvivo.org/a/n52555> .

<http://openvivo.org/a/doi10.4172/2332-0877.1000244> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,

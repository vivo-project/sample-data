<http://openvivo.org/a/doi10.4172/2329-6836.1000187> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:AcademicArticle,
        ns3:Article,

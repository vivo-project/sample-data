        <http://openvivo.org/a/n46675>,
        <http://openvivo.org/a/n59107>,
        <http://openvivo.org/a/n68716> .

<http://openvivo.org/a/doi10.4172/2327-5073.1000215> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:AcademicArticle,
        ns3:Article,

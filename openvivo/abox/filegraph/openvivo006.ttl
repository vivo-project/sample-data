<http://openvivo.org/a/doi10.6084/m9.figshare.3792180> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:Dataset,
        ns11:Thing ;
    rdfs:label "Usability vs. Purity: How UCSF and Duke Enabled Data Reuse by Going Beyond Linked Data" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3792180-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventVIVO2016> ;
    ns3:abstract "Presenters: Julia Trimmer, Anirvan Chatterjee, Eric Meeks, Richard Outten and Brian Turner<br><br>Duke and UCSF have come up with ways to make their research networking platforms indispensable at their institutions, winning friends and allies, and strengthening the case for renewed funding. Others can do this too — but only if we retrofit VIVO, Profiles, and other platforms with simple data reuse mechanisms. In this session, we’ll talk about techniques for developers, traffic growth on downstream sites, and researcher engagement. We’ll look at examples of sites that consume VIVO and Profiles data and talk about what it’s like to share data across nearly 50 local websites and apps.<br>" ;
    ns3:doi "10.6084/m9.figshare.3792180" ;
    ns3:freetextKeyword "vivo16" ;
    ns2:mostSpecificType ns1:Dataset ;
    ns1:dateCreated <http://openvivo.org/a/date2016-08-29> ;
    ns1:dateModified <http://openvivo.org/a/date2016-08-29> ;
    ns1:datePublished <http://openvivo.org/a/date2016-08-29> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-08-29> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3792180-authorship1> .


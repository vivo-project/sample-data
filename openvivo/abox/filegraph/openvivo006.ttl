    ns1:dateModified <http://openvivo.org/a/date2016-04-18> ;
    ns1:datePublished <http://openvivo.org/a/date2016-04-18> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-04-18> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3180898-authorship1> .


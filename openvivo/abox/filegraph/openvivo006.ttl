    ns2:mostSpecificType ns3:Slideshow ;
    ns1:dateCreated <http://openvivo.org/a/date2016-08-10> ;
    ns1:dateModified <http://openvivo.org/a/date2016-08-10>,
        <http://openvivo.org/a/date2016-08-17> ;
    ns1:datePublished <http://openvivo.org/a/date2016-08-10> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-08-10> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3466265-authorship1>,

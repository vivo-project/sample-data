        <http://openvivo.org/a/n98786> .

<http://openvivo.org/a/doi10.11648/j.ajpc.20150406.12> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:AcademicArticle,

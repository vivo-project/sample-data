    ns1:freetextKeyword "Librarian"^^xsd:string,
        "ORCID Ambassador"^^xsd:string,
        "Product Manager"^^xsd:string,
        "altmetrics"^^xsd:string,
        "publishing"^^xsd:string,
        "scholarly communications"^^xsd:string ;
    ns1:orcidId <http://orcid.org/0000-0002-8860-7565> ;
    ns1:overview """I strive to improve customers’ lives and aim to infuse this passion in my teams. As an experienced leader of cross-functional global teams in a matrix organization; I’ve led development efforts that have penetrated new markets, driven operational efficiencies, and built on new technical capabilities. I have deep vertical experience in scholarly communications, publishing, and library markets. I am seeking a senior product leadership role and am open to relocation.

Most recently, as Sr. Product Manager for Elsevier‘s Scopus, I built software to optimize researchers’ scholarly communication workflows. Among other things, I was product lead for Elsevier’s altmetrics initiatives and the Author Feedback Wizard suite. I serve as an ORCID Ambassador and as co-chair of the NISO Alternative Metrics Initiative’s Working Group on Definitions and Use Cases."""^^xsd:string ;
    ns1:relatedBy <http://openvivo.org/a/n3874>,
        <http://openvivo.org/a/n4163>,
        <http://openvivo.org/a/n5487> ;

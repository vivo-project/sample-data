    ns1:freetextKeyword "Semantic Web"^^xsd:string,
        "Social Semantic Web"^^xsd:string,
        "argumentation"^^xsd:string,
        "collaboration"^^xsd:string,
        "cooperation"^^xsd:string,
        "math"^^xsd:string,
        "persuasive communication"^^xsd:string,
        "scientific and scholarly communication"^^xsd:string,
        "social web"^^xsd:string ;
    ns1:orcidId <http://orcid.org/0000-0002-5098-5667> ;
    ns1:overview """My dissertation, “Enabling reuse of arguments and opinions from online social disputes”, addresses the problem of analysing, integrating, and reconciling information in online discussions. \r
\r
My research interests are in argumentation and persuasive communication, scientific and scholarly communication, the Social Semantic Web, and cooperation/collaboration (especially in socio-technical systems). I have degrees in mathematics (M.A. UT-Austin), library & information science (M.S. UIUC), and liberal arts (B.A., Great Books, St. John's College). Previously I worked in the library and book world and maintain an interest in digital libraries and library linked data."""^^xsd:string ;

<http://openvivo.org/a/doi10.6084/m9.figshare.3145315> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns3:Slideshow,
        ns11:Thing ;
    rdfs:label "ReproZip: Reproducibility with Ease" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3145315-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "<b>ReproZip </b>is a tool that allows a researcher to create a compendium for his/her experiment by automatically tracking and identifying all its required dependencies (data files, libraries, configuration files, etc.). After creating the package with little to no effort, the researcher can share it with others, who can then use ReproZip to unpack the experiment and reproduce the findings independent of their operating system, again with little to no effort." ;
    ns3:doi "10.6084/m9.figshare.3145315" ;
    ns3:freetextKeyword "FORCE16",
        "ReproZip",
        "Reproducibility" ;
    ns2:mostSpecificType ns3:Slideshow ;
    ns1:dateCreated <http://openvivo.org/a/date2016-04-02> ;
    ns1:dateModified <http://openvivo.org/a/date2016-04-02> ;
    ns1:datePublished <http://openvivo.org/a/date2016-04-02> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2016-04-02> ;
    ns1:relatedBy <http://openvivo.org/a/doi10.6084/m9.figshare.3145315-authorship1> .

<http://openvivo.org/a/doi10.6084/m9.figshare.3145318> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns3:Slideshow,
        ns11:Thing ;
    rdfs:label "An Example of Reproducibility using ReproZip" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3145318-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "This depicts an attempt to replicate the findings from an article in FiveThirtyEight that examines gender bias in the movie business using the Bechdel test: a movie passes the Bechdel test if there are (1) two women in it, (2) who talk to each other, (3) about something besides a man. The data from this example is based on a blog post by Brian Keegan, which strongly advocates for reproducibility in data journalism." ;
    ns3:doi "10.6084/m9.figshare.3145318" ;
    ns3:freetextKeyword "FORCE16",
        "ReproZip",
        "Reproducibility" ;

<http://openvivo.org/a/doi10.6084/m9.figshare.5296501> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "VIVO Implementation Services with the Web of Science" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.5296501-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventVIVO2017> ;
    ns3:abstract "This poster from the VIVO 2017 conference describes the services Clarivate Analytics offers to enhance VIVO installations." ;
    ns3:doi "10.6084/m9.figshare.5296501" ;
    ns3:freetextKeyword "#vivo17",
        "Web of Science",
        "vivo",
        "vivo17",
        "vivo2017" ;
    ns2:mostSpecificType ns1:ConferencePoster ;
    ns1:dateCreated <http://openvivo.org/a/date2017-08-09> ;
    ns1:dateModified <http://openvivo.org/a/date2017-08-09> ;
    ns1:datePublished <http://openvivo.org/a/date2017-08-09> ;
    ns1:dateTimeValue <http://openvivo.org/a/date2017-08-09> ;

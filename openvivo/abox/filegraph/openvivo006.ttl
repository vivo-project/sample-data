<http://openvivo.org/a/doi10.6084/m9.figshare.3644991> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:Dataset,
        ns11:Thing ;
    rdfs:label "Classifying Interdisciplinary Research in Scholars@TAMU" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3644991-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventVIVO2016> ;
    ns3:abstract "<div>Texas A&M University (TAMU) recently identified six interdisciplinary and societally-relevant research themes as strengths of the institution that address societal grand challenges.</div><div><br></div><div>TAMU Libraries are interested in adapting and extending the VIVO ontology in order to create a dashboard that represents research products (i.e., manuscripts and grants), accomplishments, and the communities addressing each of these themes.</div><div><br></div><div><div>This would support and demonstrate TAMU’s societal impact.</div><div><br></div><div>This poster presents a plan for the experimental classification of multidisciplinary research studies.</div></div>" ;
    ns3:doi "10.6084/m9.figshare.3644991" ;
    ns3:freetextKeyword "vivo16" ;
    ns2:mostSpecificType ns1:Dataset ;

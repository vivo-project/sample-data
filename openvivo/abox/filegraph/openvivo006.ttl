    ns1:hasPublicationVenue <http://openvivo.org/a/jou.2329-1745> ;
    ns1:relatedBy <http://openvivo.org/a/n21871>,
        <http://openvivo.org/a/n29674>,
        <http://openvivo.org/a/n40623>,
        <http://openvivo.org/a/n45853> .

<http://openvivo.org/a/doi10.11648/j.ejb.20170502.12> a ns5:BFO_0000001,
        ns5:BFO_0000002,

        <http://openvivo.org/a/n38740>,
        <http://openvivo.org/a/n59423>,
        <http://openvivo.org/a/n98827> .

<http://openvivo.org/a/doi10.11648/j.sjcm.20150406.12> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,

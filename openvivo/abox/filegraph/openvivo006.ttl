    rdfs:label "Dumontier, Michel"@en-US ;
    ns5:ARG_2000028 <http://openvivo.org/a/orcid0000-0003-4727-9435-vcard> ;
    ns5:RO_0000053 <http://openvivo.org/a/orcid0000-0003-4727-9435-http://openvivo.org/a/eventFORCE2016> ;

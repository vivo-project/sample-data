<http://openvivo.org/a/doi10.6084/m9.figshare.3185191> a ns5:BFO_0000001,
        ns5:BFO_0000002,
        ns5:BFO_0000031,
        ns5:IAO_0000030,
        ns3:Document,
        ns1:ConferencePoster,
        ns11:Thing ;
    rdfs:label "Force11_Poster_SCR.pdf" ;
    ns5:ARG_2000028 <http://openvivo.org/a/doi10.6084/m9.figshare.3185191-vcard> ;
    ns5:RO_0002353 <http://openvivo.org/a/eventFORCE2016> ;
    ns3:abstract "<p>Interactive publications, including analysis notebooks and interactive figures that are distinct from canonical static figures, will need to separate content from their visual representation. This has implications for the long term stability of visual representations and the provenance of claims, evidence, and arguments built on those representations.</p>" ;
    ns3:doi "10.6084/m9.figshare.3185191" ;

    ns1:awardOrHonor <http://vivo.ufl.edu/individual/n74796> ;
    ns1:educationalTraining <http://vivo.ufl.edu/individual/n63155> ;
    ns1:hasRole <http://vivo.ufl.edu/individual/n1133020145>,
        <http://vivo.ufl.edu/individual/n1255557347>,
        <http://vivo.ufl.edu/individual/n1397837816>,
        <http://vivo.ufl.edu/individual/n1725790417>,
        <http://vivo.ufl.edu/individual/n1801553329>,

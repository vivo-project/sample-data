<http://vivo.ufl.edu/individual/n118597> a ns2:UFEntity,
        ns1:AcademicDepartment,
        ns1:Department,
        ns8:Thing,
        <http://xmlns.com/foaf/0.1/Agent>,
        <http://xmlns.com/foaf/0.1/Organization> ;
    ns5:modTime "2011-08-04T09:12:48"^^xsd:dateTime ;
    ns1:overview "<p>Welcome to the Department of Sociology and Criminology &amp; Law! We are a thriving department with over 1,000 undergraduate majors and 100 graduate students. Our faculty are internationally known for their research in the areas of families, gender, and sexualities; health, aging, and the life course; environmental and resource sociology; race and ethnicity; criminology and criminal justice; and psychology and law. We take great pride in the fact that our faculty are involved in interdisciplinary research projects that span nearly of all of the University&rsquo;s colleges and academic programs, including: the School of Natural Resources and the Environment, the Water Institute, the Emerging Pathogens Institute, the Center for Latin American Studies, the Center for European Studies, the Center for Women&rsquo;s Studies and Gender Research, the Health Science Center, and the Jewish Studies Center. Wherever you go on campus, you will most likely find at least one Sociologist or Criminologist from our department making major contributions.&nbsp;</p>" ;
    ns1:subOrganizationWithin <http://vivo.ufl.edu/individual/n8858828> .


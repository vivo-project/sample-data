<http://vivo.ufl.edu/individual/n189381464> a ns2:UFCurrentEntity,
        ns2:UFEntity,
        ns1:FacultyMember,
        ns8:Thing,
        <http://xmlns.com/foaf/0.1/Agent>,
        <http://xmlns.com/foaf/0.1/Person> ;
    ns5:modTime "2011-07-14T11:59:50"^^xsd:dateTime ;
    ns2:dateHarvested "2012-08-20T12:55:13.581000",
        "2012-08-20T13:12:49",
        "2013-10-14T10:06:53.069719",
        "2014-01-28T16:39:07.937452" ;
    ns1:educationalTraining <http://vivo.ufl.edu/individual/n106323>,
        <http://vivo.ufl.edu/individual/n124112>,
        <http://vivo.ufl.edu/individual/n193463> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1546166560>,
        <http://vivo.ufl.edu/individual/n1553241171>,
        <http://vivo.ufl.edu/individual/n1970188144>,
        <http://vivo.ufl.edu/individual/n2118899261>,
        <http://vivo.ufl.edu/individual/n390192291>,
        <http://vivo.ufl.edu/individual/n418147773>,
        <http://vivo.ufl.edu/individual/n561734866>,
        <http://vivo.ufl.edu/individual/n569440786>,
        <http://vivo.ufl.edu/individual/n782263194> ;
    ns1:overview "Human-disease system is an interactive system, where disease infects human beings while human beings may take actions to prevent infections. In recent years, emerging and re-emerging infectious diseases have obtained unprecedented attention due to the widespread occurrence of severe acute respiratory syndrome (SARS), bird flu, and the new H1N1 flu. My research aims to offer better understandings on the complex human-disease system, with GIS, agent-based simulation, and statistical methodologies. My dissertation established an agent-based dual-diffusion model to couple the diffusion of influenza and the diffusion of human preventive behavior against influenza. This spatially explicit model is used to: 1) understand the spatio-temporal dynamics of this dual-diffusion in the city of Buffalo, NY, 2) evaluate the combined effects of mitigation strategies and human preventive behavior, and 3) explore health policies to promote preventive behavior against influenza. The research results are expected to inform scientists, health policy makers, and local governments to overcome the current challenge posed by the looming influenza pandemic." ;
    ns1:primaryEmail "liangmao@ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 392-0494 ext. 214" ;
    ns1:researchOverview "Spatial modeling for epidemiology, Agent-based simulation for disease transmission, Disease control and prevention policies, Spatial/Social network analysis, and Diffusion of human health behavior." .


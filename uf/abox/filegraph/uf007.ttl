<http://vivo.ufl.edu/individual/n505> a ns2:UFCurrentEntity,
        ns2:UFEntity,
        ns1:NonAcademic,
        ns8:Thing,
        <http://xmlns.com/foaf/0.1/Agent>,
        <http://xmlns.com/foaf/0.1/Person> ;
    ns5:modTime "2011-10-24T09:54:43"^^xsd:dateTime ;
    ns1:hasAttendeeRole <http://vivo.ufl.edu/individual/n37835>,
        <http://vivo.ufl.edu/individual/n642432> ;
    ns1:hasLeaderRole <http://vivo.ufl.edu/individual/n128759> ;
    ns1:overview "Narayan Raum is an Level 3 Application Analyst, Senior Project Manager, and IT Senior in the UF Health Information Services Department. Narayan is currently responsible for supporting multiple Clinical Department Applications (CDAs), which are critical applications for continuity of care in the UF Health environment. Narayan is also the project manager for an enterprise implementation of AtTask, a portfolio and project management system that will be implemented across the UF Health Information Services teams by the end of 2013. Narayan is the former Assistant Director of Research IT in the Clinical &amp; Translational Science IT department at the University of Florida. His responsibilities included grant writing, contract development and assisting the director in managing the daily operations of a 25 member software engineering auxiliary known as the Clinical and Translational Research Informatics Program (CTRIP). He was also key personnel on several large multicenter grants including the NIH funded VIVO: Enabling National Networking of Scientists. Additionally, he supported the informatics needs of a five year, NIAMS and NINDS funded research grant to investigate the potential of magnetic resonance imaging (MRI) to noninvasively monitor disease progression in Duchenne muscular dystrophy. He is actively pursuing additional grant funding and contracts in multiple areas of informatics and research. He has developed and/or presented over a dozen posters at national conferences and is pursuing publication in journals that reflect his accomplishments, knowledge and findings in unique research infrastructure systems." ;
    ns1:primaryEmail "nraum@ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 294-5277 ext. 86239" .


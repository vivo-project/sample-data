    ns2:dateHarvested "2012-09-10T14:44:14.284000",
        "2012-10-01T17:19:04.675000" ;
    ns1:awardOrHonor <http://vivo.ufl.edu/individual/n181755>,
        <http://vivo.ufl.edu/individual/n41366>,
        <http://vivo.ufl.edu/individual/n49758>,
        <http://vivo.ufl.edu/individual/n68989> ;
    ns1:educationalTraining <http://vivo.ufl.edu/individual/n112713>,
        <http://vivo.ufl.edu/individual/n37320>,
        <http://vivo.ufl.edu/individual/n94640> ;
    ns1:hasInvestigatorRole <http://vivo.ufl.edu/individual/n2407658257>,
        <http://vivo.ufl.edu/individual/n3572179621>,
        <http://vivo.ufl.edu/individual/n6685809554> ;
    ns1:hasLeaderRole <http://vivo.ufl.edu/individual/n1336663> ;
    ns1:overview "I have worked to develop proficiency in fMRI paradigm development and implementation, various scanning techniques, and computer programming. These skills have allowed me to use a variety of software packages for the analysis of neuroimaging data. At present, I am developing an increasing understanding of the pain/brain/behavior relationships with the goal of creating a career long fundable line of research in the field of pain." ;
    ns1:primaryEmail "jcraggs@phhp.ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 273-6151" ;
    ns1:researchOverview "The primary focus of my research is describing the relationships between brain morphology, structure, and function. Another focus of my research involves the translation of neuroimaging results into real-world applications for clinical population." .


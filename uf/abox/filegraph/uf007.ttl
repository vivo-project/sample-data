    ns1:awardOrHonor <http://vivo.ufl.edu/individual/n28028> ;
    ns1:educationalTraining <http://vivo.ufl.edu/individual/n48339>,
        <http://vivo.ufl.edu/individual/n60865> ;
    ns1:hasRole <http://vivo.ufl.edu/individual/n1223789367>,
        <http://vivo.ufl.edu/individual/n1667862085>,
        <http://vivo.ufl.edu/individual/n485242574> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1003039018>,
        <http://vivo.ufl.edu/individual/n1094422681>,
        <http://vivo.ufl.edu/individual/n122410756>,
        <http://vivo.ufl.edu/individual/n1239458304>,
        <http://vivo.ufl.edu/individual/n1336844245>,
        <http://vivo.ufl.edu/individual/n1555811322>,
        <http://vivo.ufl.edu/individual/n1770632960>,
        <http://vivo.ufl.edu/individual/n1868682753>,
        <http://vivo.ufl.edu/individual/n2017059075>,
        <http://vivo.ufl.edu/individual/n2133048852>,
        <http://vivo.ufl.edu/individual/n213684347>,
        <http://vivo.ufl.edu/individual/n400781349>,
        <http://vivo.ufl.edu/individual/n410662196>,
        <http://vivo.ufl.edu/individual/n468700714>,
        <http://vivo.ufl.edu/individual/n470451760>,
        <http://vivo.ufl.edu/individual/n635338818>,
        <http://vivo.ufl.edu/individual/n687280607>,
        <http://vivo.ufl.edu/individual/n700735579>,
        <http://vivo.ufl.edu/individual/n848422840>,
        <http://vivo.ufl.edu/individual/n849071610>,
        <http://vivo.ufl.edu/individual/n895112203> ;
    ns1:overview "I&nbsp; graduated in Physics and Astronomy in 1989 at the Universidad  Complutense de Madrid (Spain). I obtained my PhD at the University of  Durham (England) in 1994. My first postdoctoral position was held at the  University of California Observatories in Santa Cruz, working on the  \"Deep Extragalactic Evolutionary Probe\" Survey. In 1998, I was awarded a  Hubble Fellowship at Yale University. I joined the UF Department of  Astronomy in 2001 as a tenure-track Assistant Professor. I became a  tenured Associate Professor at UF in 2003. In 2006, I was awarded a  Distinguished Professorship at the Universidad Complutense de Madrid,  and I maintained a joint position as Honorary Collaborator until 2009. I  am currently Deputy PI of a major project entitled \"First Science with  the GTC\", funded by the Consolider-Ingenio 2010 Program of the Spanish  Ministry of Science and Innovation. From 2008 to 2010, I served as Chair  of the GTC International Steering Committee and as Executive Director  of the International School for Advanced Instrumentation. In 2009, I was  promoted to Full Professor and appointed Chair of the Department of  Astronomy at the University of Florida." ;
    ns1:primaryEmail "rgll@ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 294-1878" ;
    ns1:researchOverview "My main area of research is galaxy evolution over cosmological  timescales. In particular, I study the structure, kinematics and stellar  populations of galaxies both in the nearby universe and in the distant  universe. The comparative analysis of these galaxy properties at  different epochs allows us to describe how galaxies have evolved in the  last 12 billion years." .


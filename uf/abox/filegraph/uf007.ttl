    ns1:awardOrHonor <http://vivo.ufl.edu/individual/n189517> ;
    ns1:educationalTraining <http://vivo.ufl.edu/individual/n1175592>,
        <http://vivo.ufl.edu/individual/n126521> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1080627863>,
        <http://vivo.ufl.edu/individual/n1840990458>,
        <http://vivo.ufl.edu/individual/n349698489>,
        <http://vivo.ufl.edu/individual/n5783381> ;
    ns1:researchOverview """<p>\r
<p>My research interests are:</p>\r
<p>Phase III Organon (Sugammadex) trials comparing the recovery of neuromuscular block induced by Rocuronium versus Succinylcholine.</p>\r
<p>Comparison of effects of On-pump versus Off-pump CABG on plasma levels of BNP and ANP</p>\r
<p>Does dexmedetomidine provide adequate sedation and hemodynamic control for awake diagnostic TEE?</p>\r
</p>""" .


        "2013-10-21T10:19:17.821167" ;
    ns1:awardOrHonor <http://vivo.ufl.edu/individual/n130086>,
        <http://vivo.ufl.edu/individual/n270624>,
        <http://vivo.ufl.edu/individual/n80974> ;

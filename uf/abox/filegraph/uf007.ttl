    ns1:hasInvestigatorRole <http://vivo.ufl.edu/individual/n44869>,
        <http://vivo.ufl.edu/individual/n7170910275> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n173951457>,
        <http://vivo.ufl.edu/individual/n340808431> ;
    ns1:overview "My areas of interest are data science, informatics and the semantic web. I serve as the Director for the Clinical and Translational Science Informatics & Technology Department in the UF Clinical and Translational Science Institute. In this position I work on translational research projects and multi-site clinical trials. I served as a national development team Lead on the grant “VIVO: Establishing a National Network of Scientists”, funded by NCRR U24RR029822. My work on this project focused on, large scale data ingest tools, maintaining the open source community, and encouraging public adoption and participation in the VIVO project. I am currently the international working group chair for the VIVO Applications and Tools Working group sponsored by the DuraSpace foundation." ;
    ns1:primaryEmail "cpb@ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 294-5046" .


<http://vivo.ufl.edu/individual/n188489985> a ns2:UFCurrentEntity,
        ns2:UFEntity,
        <http://xmlns.com/foaf/0.1/Person> ;
    ns5:modTime "2014-02-11T22:07:41"^^xsd:dateTime ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1004153918>,
        <http://vivo.ufl.edu/individual/n262429093> ;
    ns1:overview "<p>Teresa d&rsquo;Angelo is the Director of Research Services at the UF CTSI. In this role, Teresa manages the delivery of research services to investigators at UF including oversight of the Clinical Research Center (CRC). Additionally, her responsibilities encompass a supervisory role in REDCap, quality assurance, RAC/IRB support and navigator services. She also leads the coordination and support of other CTSI-affiliated units that provide informatics, biostatistics, regulatory, core facility and Integrated Data Repository services. Previously, Teresa served as Nurse Manager of the Clinical Research Center for 10 years. Prior to joining the CRC, Teresa directed a private research company with multiple sites, managed a broad spectrum of industry-sponsored pharmaceutical trials, and worked for 17 years at the NIH Clinical Center.</p>" ;
    ns1:primaryEmail "teresadangelo@ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 294-5881" .


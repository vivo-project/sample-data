<http://vivo.ufl.edu/individual/n34350> a ns2:UFEntity,
        ns1:AcademicDepartment,
        ns1:Department,
        ns8:Thing,
        <http://xmlns.com/foaf/0.1/Agent>,
        <http://xmlns.com/foaf/0.1/Organization> ;
    ns5:modTime "2011-08-04T09:15:58"^^xsd:dateTime ;
    ns1:overview """<p>The University of Florida&rsquo;s department of Urban and Regional Planning was founded in 1974.&nbsp; The department defines its mission as being the leader in planning education, research and practice for the citizens of Florida, the Southeast and the nation. The faculty in the Department of Urban and Regional Planning define &ldquo;Urban and Regional Planning&rdquo; as a professional practice that seeks to apply systematic thinking, knowledge, ethical and societal principles and innovative technologies to the problems and challenges of the natural environment, regional and urban systems.</p>\r
<p>Specializations offered by the department are: Information Technologies for Planning, Transportation and Growth Management, Housing, Community and Economic Development, and Urban Design.</p>\r
<p>&nbsp;</p>""" ;
    ns1:subOrganizationWithin <http://vivo.ufl.edu/individual/n765314> .


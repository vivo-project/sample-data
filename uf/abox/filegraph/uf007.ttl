    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1292370328>,
        <http://vivo.ufl.edu/individual/n1387548047>,
        <http://vivo.ufl.edu/individual/n143157356>,
        <http://vivo.ufl.edu/individual/n1445048360>,
        <http://vivo.ufl.edu/individual/n1643908650>,
        <http://vivo.ufl.edu/individual/n288195201> ;
    ns1:overview "Performs primarily adult diagnostic evaluations and offers audiologic rehabilitation, including amplification. Has worked 15 years in the University setting and 5+ years in a private practice setting. Has developed expertise in fitting advanced digital hearing aids. Works with tinnitus patients. Is certified in Tinnitus Retraining Therapy and in Neuromonics Tinnitus Treatment. Presents topics on hearing loss , amplification, and related subjects to physician groups, community organizations, and senior citizen groups. Is presently Chairperson of the Hearing Aid Task Force. Participates in the Universal Newborn Hearing Screening Program." ;
    ns1:primaryEmail "shermar@phhp.ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 294-5151" .


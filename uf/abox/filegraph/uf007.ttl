    ns1:educationalTraining <http://vivo.ufl.edu/individual/n149094>,
        <http://vivo.ufl.edu/individual/n40894>,
        <http://vivo.ufl.edu/individual/n75956> ;
    ns1:hasCredential <http://vivo.ufl.edu/individual/n190736> ;
    ns1:hasLeaderRole <http://vivo.ufl.edu/individual/n137051>,
        <http://vivo.ufl.edu/individual/n141927>,
        <http://vivo.ufl.edu/individual/n162777>,
        <http://vivo.ufl.edu/individual/n231873>,
        <http://vivo.ufl.edu/individual/n237885>,
        <http://vivo.ufl.edu/individual/n446085> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n651736203> ;
    ns1:overview "Represent department in recruiting activities. Process documents for matriculation from admissions to graduation. Coordinate and present departmental orientation. Taught UF's First year Florida (Orientation Course). Developed cultural and informational workshop series presented by students for students. Present college of engineering freshman and transfer orientation. Plan, coordinate and orchestrate the annual career&nbsp; workshop. Participate on departmental and College of Engineering committees and University-wide research projects. Prepare, disseminate and review program correspondence. Design, revise and purchase program marketing materials including website upkeep and social media. Edit and revise the Civil and Coastal Engineering (CCE) Graduate Student Handbook. Analyze and compile student-based program data. Created and now advisor&nbsp; to the CCE Graduate Student Advisory Group. Liaison between and the CCE graduate students and departmental faculty and leadership. Plan and implement student activities. Coordinate CCE Graduate Student Recruiting Weekend. Prepare and maintain area budget. Collect and input course grades. Supervise program assistants. Intervene with various campus offices in order to clarify and resolve student issues regarding admissions, financial issues, international student documents, registration and graduation. Maintain departmental records regarding graduate faculty workload. Coordinated department's centennial celebration events. Coordinate graduate events." ;
    ns1:primaryEmail "nancy@ce.ufl.edu" ;
    ns1:primaryPhoneNumber "(352) 392-9537 ext. 1419" .


    ns1:educationalTraining <http://vivo.ufl.edu/individual/n122664>,
        <http://vivo.ufl.edu/individual/n84922>,
        <http://vivo.ufl.edu/individual/n97528> ;
    ns1:hasTeacherRole <http://vivo.ufl.edu/individual/n1166600489>,
        <http://vivo.ufl.edu/individual/n1711016429>,
        <http://vivo.ufl.edu/individual/n2046053130>,
        <http://vivo.ufl.edu/individual/n226890353>,
        <http://vivo.ufl.edu/individual/n664877012> ;
    ns1:overview "<strong></strong>Professor  Tortorice has taught undergraduate clinical section and Principles of  Leadership and Management for Professional Nursing Practice.&nbsp; She is the  Director of the RN Residency program at the NF/SG VHS. Professor Tortorice  serves on the Nurse Professional Standards Board and the Professional  Practice Council at the NF/SG VHS.&nbsp; She is a member of the American  Nurses Association, Florida Nurses Association, American Organization of  Nurse Executives, Florida Organization of Nurse Executives, and Sigma  Theta Tau.&nbsp; Professor Tortorice has served as a loaned executive for the  United Way, Community Business partner for Niblack Middle School in  Lake City, Member of the We Care Board of Directors, Gainesville Public  Health Department, State Delegate to National Association for Healthcare  Quality, Regional President for the Florida Association of Healthcare  Quality, North Central Florida Chapter, and Vice-President for the  Alabama Association of Healthcare Quality Professionals." .

<http://vivo.ufl.edu/individual/n30772> a ns1:Presentation .

<http://vivo.ufl.edu/individual/n30802> a ns2:CourtesyFaculty,
        ns2:UFCurrentEntity,
        ns2:UFEntity,

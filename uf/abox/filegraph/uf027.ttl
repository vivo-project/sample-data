<http://vivo.ufl.edu/individual/n1841030414> rdfs:label "Genetic Restoration of the Florida Panther" ;
    ns4:creator <http://vivo.ufl.edu/individual/n18211>,
        <http://vivo.ufl.edu/individual/n2171961446>,
        <http://vivo.ufl.edu/individual/n2453872468>,
        <http://vivo.ufl.edu/individual/n3681623635>,
        <http://vivo.ufl.edu/individual/n3967469472>,
        <http://vivo.ufl.edu/individual/n4189898754>,

<http://vivo.ufl.edu/individual/n2657211716> rdfs:label "High-Throughput Genetic Mapping of Mutants Via Quantitative Single Nucleotide Polymorphism Typing" ;
    ns4:creator <http://vivo.ufl.edu/individual/n3972052293>,
        <http://vivo.ufl.edu/individual/n51864>,
        <http://vivo.ufl.edu/individual/n5870411274>,
        <http://vivo.ufl.edu/individual/n7496023468>,
        <http://vivo.ufl.edu/individual/n8635225773>,
        <http://vivo.ufl.edu/individual/n9105148428>,
        <http://vivo.ufl.edu/individual/n9167662631>,
        <http://vivo.ufl.edu/individual/n9447365481>,
        <http://vivo.ufl.edu/individual/n9710500764> ;
    ns4:title "High-Throughput Genetic Mapping of Mutants Via Quantitative Single Nucleotide Polymorphism Typing" ;
    ns6:abstract "Advances in next-generation sequencing technology have facilitated the discovery of single nucleotide polymorphisms (SNPs). Sequenom-based SNP-typing assays were developed for 1359 maize SNPs identified via comparative next-generation transcriptomic sequencing. Approximately 75% of these SNPs were successfully converted into genetic markers that can be scored reliably and used to generate a SNP-based genetic map by genotyping recombinant inbred lines from the intermated B73 x Mo17 population. The quantitative nature of Sequenom-based SNP assays led to the development of a time- and cost-efficient strategy to genetically map mutants via quantitative bulked segregant analysis. This strategy was used to rapidly map the loci associated with several dozen recessive mutants. Because a mutant can be mapped using as few as eight multiplexed sets of SNP assays on a bulk of as few as 20 mutant F(2) individuals, this strategy is expected to be widely adopted for mapping in many species." ;
    ns6:pageStart "19" ;
    ns6:volume "184" ;
    ns3:harvestedBy "Python Pubs version 1.1" ;
    ns1:informationResourceInAuthorship <http://vivo.ufl.edu/individual/n2934755893>,
        <http://vivo.ufl.edu/individual/n323810823>,
        <http://vivo.ufl.edu/individual/n401950210>,
        <http://vivo.ufl.edu/individual/n4374590606>,
        <http://vivo.ufl.edu/individual/n5220275233>,
        <http://vivo.ufl.edu/individual/n668772363>,
        <http://vivo.ufl.edu/individual/n6705452296>,
        <http://vivo.ufl.edu/individual/n7878556077>,
        <http://vivo.ufl.edu/individual/n9989758434> ;
    ns1:pmcid "PMC2815916" .


        <http://vivo.ufl.edu/individual/n8722843203>,
        <http://vivo.ufl.edu/individual/n923872848>,
        <http://vivo.ufl.edu/individual/n9563082985> ;
    ns1:nihmsid "NIHMS503073" ;
    ns1:pmcid "PMC3755594" .

<http://vivo.ufl.edu/individual/n574423592> rdfs:label "Structural and Enzymatic Characterization of Nans (Yjhs), a 9-O-Acetyl N-Acetylneuraminic Acid Esterase From Escherichia Coli O157:H7" ;
    ns4:creator <http://vivo.ufl.edu/individual/n28998>,
        <http://vivo.ufl.edu/individual/n3604136446>,
        <http://vivo.ufl.edu/individual/n361886424>,
        <http://vivo.ufl.edu/individual/n5746681265>,
        <http://vivo.ufl.edu/individual/n5769759932>,
        <http://vivo.ufl.edu/individual/n6281984150>,
        <http://vivo.ufl.edu/individual/n7230789067>,
        <http://vivo.ufl.edu/individual/n8379897112>,
        <http://vivo.ufl.edu/individual/n9484128373> ;
    ns4:title "Structural and Enzymatic Characterization of Nans (Yjhs), a 9-O-Acetyl N-Acetylneuraminic Acid Esterase From Escherichia Coli O157:H7" ;
    ns6:abstract "There is a high prevalence of sialic acid in a number of different organisms, resulting in there being a myriad of different enzymes that can exploit it as a fermentable carbon source. One such enzyme is NanS, a carbohydrate esterase that we show here deacetylates the 9 position of 9-O-sialic acid so that it can be readily transported into the cell for catabolism. Through structural studies, we show that NanS adopts a SGNH hydrolase fold. Although the backbone of the structure is similar to previously characterized family members, sequence comparisons indicate that this family can be further subdivided into two subfamilies with somewhat different fingerprints. NanS is the founding member of group II. Its catalytic center contains Ser19 and His301 but no Asp/Glu is present to form the classical catalytic triad. The contribution of Ser19 and His301 to catalysis was confirmed by mutagenesis. In addition to structural characterization, we have mapped the specificity of NanS using a battery of substrates." ;
    ns6:pageStart "1208" ;
    ns6:volume "20" ;
    ns3:grantCited "GSP-48370" ;
    ns3:harvestedBy "Python Pubs version 1.1" ;
    ns1:informationResourceInAuthorship <http://vivo.ufl.edu/individual/n1211737458>,
        <http://vivo.ufl.edu/individual/n1776386977>,
        <http://vivo.ufl.edu/individual/n2156742283>,
        <http://vivo.ufl.edu/individual/n2553861573>,
        <http://vivo.ufl.edu/individual/n2605970574>,
        <http://vivo.ufl.edu/individual/n3947081922>,
        <http://vivo.ufl.edu/individual/n4972719141>,
        <http://vivo.ufl.edu/individual/n7134829999>,
        <http://vivo.ufl.edu/individual/n7693837398> ;

<http://vivo.ufl.edu/individual/n5011375481> rdfs:label "Alcohol Price and Intoxication in College Bars" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1007814175>,
        <http://vivo.ufl.edu/individual/n10199>,
        <http://vivo.ufl.edu/individual/n157358>,

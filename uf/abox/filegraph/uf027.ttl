<http://vivo.ufl.edu/individual/n3987009099> rdfs:label "Myocardial Infarction Risk Among Patients With Fractures Receiving Bisphosphonates" ;
    ns6:abstract "To determine if bisphosphonates are associated with reduced risk of acute myocardial infarction (AMI)." ;
    ns6:number "1" ;

<http://vivo.ufl.edu/individual/n92318107> rdfs:label "Grade Guidelines: 9. Rating Up the Quality of Evidence" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1018843203>,
        <http://vivo.ufl.edu/individual/n1100507672>,
        <http://vivo.ufl.edu/individual/n1249>,

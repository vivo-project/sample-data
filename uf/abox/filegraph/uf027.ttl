<http://vivo.ufl.edu/individual/n4034009646> rdfs:label "Two Earth-Sized Planets Orbiting Kepler-20" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1153272250>,
        <http://vivo.ufl.edu/individual/n1788217899>,

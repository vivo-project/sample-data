<http://vivo.ufl.edu/individual/n1669228568> rdfs:label "Renal Function and Nonvertebral Fracture Risk in Multiethnic Women: the Women'S Health Initiative (Whi)" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1371723246>,
        <http://vivo.ufl.edu/individual/n1854319074>,
        <http://vivo.ufl.edu/individual/n21233>,
        <http://vivo.ufl.edu/individual/n3844290357>,
        <http://vivo.ufl.edu/individual/n447993197>,
        <http://vivo.ufl.edu/individual/n4516815301>,
        <http://vivo.ufl.edu/individual/n4763978594>,
        <http://vivo.ufl.edu/individual/n5499653038>,
        <http://vivo.ufl.edu/individual/n5878548198>,
        <http://vivo.ufl.edu/individual/n5917811632>,
        <http://vivo.ufl.edu/individual/n6538469807> ;
    ns4:title "Renal Function and Nonvertebral Fracture Risk in Multiethnic Women: the Women'S Health Initiative (Whi)" ;
    ns6:abstract "To examine the association between renal function and fracture in multiethnic women, we studied postmenopausal women enrolled in the Women's Health Initiative. Postmenopausal White women with mild renal dysfunction were at increased risk of nonvertebral fracture; this association was at least partially explained by effects of renal dysfunction on chronic inflammation. Reduced renal function appeared to increase fracture risk among Black women, but there was little evidence to support this association among other racial/ethnic groups." ;
    ns6:pageStart "887" ;
    ns6:volume "23" ;

<http://vivo.ufl.edu/individual/n5383782949> rdfs:label "Study Protocol: Home-Based Telehealth Stroke Care: a Randomized Trial for Veterans" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1907280501>,
        <http://vivo.ufl.edu/individual/n20335>,
        <http://vivo.ufl.edu/individual/n294930555>,
        <http://vivo.ufl.edu/individual/n4827570236>,
        <http://vivo.ufl.edu/individual/n507513370>,
        <http://vivo.ufl.edu/individual/n5348231420>,
        <http://vivo.ufl.edu/individual/n5586054723>,
        <http://vivo.ufl.edu/individual/n8398085945>,
        <http://vivo.ufl.edu/individual/n9608802307>,
        <http://vivo.ufl.edu/individual/n9655725720> ;
    ns4:title "Study Protocol: Home-Based Telehealth Stroke Care: a Randomized Trial for Veterans" ;
    ns6:abstract "Stroke is one of the most disabling and costly impairments of adulthood in the United States. Stroke patients clearly benefit from intensive inpatient care, but due to the high cost, there is considerable interest in implementing interventions to reduce hospital lengths of stay. Early discharge rehabilitation programs require coordinated, well-organized home-based rehabilitation, yet lack of sufficient information about the home setting impedes successful rehabilitation. This trial examines a multifaceted telerehabilitation (TR) intervention that uses telehealth technology to simultaneously evaluate the home environment, assess the patient's mobility skills, initiate rehabilitative treatment, prescribe exercises tailored for stroke patients and provide periodic goal oriented reassessment, feedback and encouragement." ;
    ns6:volume "11" ;
    ns3:harvestedBy "Python Pubs version 1.1" ;
    ns1:informationResourceInAuthorship <http://vivo.ufl.edu/individual/n1882315673>,
        <http://vivo.ufl.edu/individual/n2094527325>,

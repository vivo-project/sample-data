<http://vivo.ufl.edu/individual/n8796229584> rdfs:label "Inhibition of Chemokine-Glycosaminoglycan Interactions in Donor Tissue Reduces Mouse Allograft Vasculopathy and Transplant Rejection" ;
    ns4:creator <http://vivo.ufl.edu/individual/n14528>,
        <http://vivo.ufl.edu/individual/n1660016011>,
        <http://vivo.ufl.edu/individual/n1741883710>,
        <http://vivo.ufl.edu/individual/n177>,
        <http://vivo.ufl.edu/individual/n2108419812>,
        <http://vivo.ufl.edu/individual/n2139451331;http://vivo.ufl.edu/individual/n194928235;http://vivo.ufl.edu/individual/n11260;http://vivo.ufl.edu/individual/n7170>,
        <http://vivo.ufl.edu/individual/n2387922538>,
        <http://vivo.ufl.edu/individual/n29416>,
        <http://vivo.ufl.edu/individual/n3085928352>,
        <http://vivo.ufl.edu/individual/n38011>,
        <http://vivo.ufl.edu/individual/n43583>,
        <http://vivo.ufl.edu/individual/n5860023275>,
        <http://vivo.ufl.edu/individual/n7773060979>,
        <http://vivo.ufl.edu/individual/n783131902>,
        <http://vivo.ufl.edu/individual/n938150008> ;
    ns4:title "Inhibition of Chemokine-Glycosaminoglycan Interactions in Donor Tissue Reduces Mouse Allograft Vasculopathy and Transplant Rejection" ;
    ns6:abstract "Binding of chemokines to glycosaminoglycans (GAGs) is classically described as initiating inflammatory cell migration and creating tissue chemokine gradients that direct local leukocyte chemotaxis into damaged or transplanted tissues. While chemokine-receptor binding has been extensively studied during allograft transplantation, effects of glycosaminoglycan (GAG) interactions with chemokines on transplant longevity are less well known. Here we examine the impact of interrupting chemokine-GAG interactions and chemokine-receptor interactions, both locally and systemically, on vascular disease in allografts." ;
    ns6:volume "5" ;
    ns3:grantCited "1RC1HL100202-01",
        "MOP 577578" ;
    ns3:harvestedBy "Python Pubs version 1.1" ;
    ns1:informationResourceInAuthorship <http://vivo.ufl.edu/individual/n1494552872>,

<http://vivo.ufl.edu/individual/n2431973996> rdfs:label "Daily Measures of Microbes and Human Health At a Non-Point Source Marine Beach" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1054>,
        <http://vivo.ufl.edu/individual/n1253954470>,
        <http://vivo.ufl.edu/individual/n1256602677>,
        <http://vivo.ufl.edu/individual/n135546146>,

<http://vivo.ufl.edu/individual/n5483817073> rdfs:label "Use of Integrated Malaria Management Reduces Malaria in Kenya" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1548602218>,
        <http://vivo.ufl.edu/individual/n1862331241>,
        <http://vivo.ufl.edu/individual/n2042646585>,
        <http://vivo.ufl.edu/individual/n2509401319>,
        <http://vivo.ufl.edu/individual/n3494382993>,
        <http://vivo.ufl.edu/individual/n35025>,
        <http://vivo.ufl.edu/individual/n3873840593>,
        <http://vivo.ufl.edu/individual/n5456187361>,
        <http://vivo.ufl.edu/individual/n9957745713> ;
    ns4:title "Use of Integrated Malaria Management Reduces Malaria in Kenya" ;
    ns6:abstract "During an entomological survey in preparation for malaria control interventions in Mwea division, the number of malaria cases at the Kimbimbi sub-district hospital was in a steady decline. The underlying factors for this reduction were unknown and needed to be identified before any malaria intervention tools were deployed in the area. We therefore set out to investigate the potential factors that could have contributed to the decline of malaria cases in the hospital by analyzing the malaria control knowledge, attitudes and practices (KAP) that the residents in Mwea applied in an integrated fashion, also known as integrated malaria management (IMM)." ;
    ns6:volume "3" ;
    ns3:harvestedBy "Python Pubs version 1.0" ;
    ns1:informationResourceInAuthorship <http://vivo.ufl.edu/individual/n2203845501>,

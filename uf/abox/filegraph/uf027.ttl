<http://vivo.ufl.edu/individual/n1290572542> rdfs:label "Standardized Evaluation Methodology and Reference Database for Evaluating Coronary Artery Centerline Extraction Algorithms" ;
    ns4:creator <http://vivo.ufl.edu/individual/n1325098106>,
        <http://vivo.ufl.edu/individual/n1520678023>,
        <http://vivo.ufl.edu/individual/n2132165993>,

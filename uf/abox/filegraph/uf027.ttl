<http://vivo.ufl.edu/individual/n6892201385> rdfs:label "Global Conservation Priorities for Marine Turtles" ;
    ns4:creator <http://vivo.ufl.edu/individual/n106856>,
        <http://vivo.ufl.edu/individual/n1476486426>,
        <http://vivo.ufl.edu/individual/n183243603>,
        <http://vivo.ufl.edu/individual/n1985091775>,
        <http://vivo.ufl.edu/individual/n2081198326>,
        <http://vivo.ufl.edu/individual/n289892206>,
        <http://vivo.ufl.edu/individual/n29930>,
        <http://vivo.ufl.edu/individual/n31117>,
        <http://vivo.ufl.edu/individual/n3583894528>,

<http://vivo.ufl.edu/individual/n6464271878> rdfs:label "The Promise of Nanotechnology for Solving Clinical Problems in Breast Cancer" ;
    ns4:creator <http://vivo.ufl.edu/individual/n11287>,
        <http://vivo.ufl.edu/individual/n1619045312>,
        <http://vivo.ufl.edu/individual/n26143>,

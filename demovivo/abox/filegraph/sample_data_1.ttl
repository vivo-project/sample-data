<http://vivo.demovivo.edu/individual/work1440949> a ns1:Chapter ;
    rdfs:label "Erden alle Zeichen tief sein, bis zum sechsten"@de-DE,
        "Very signs deep shall, under moved unto sixth"@en-CA,
        "Very signs deep shall, under moved unto sixth"@en-US,

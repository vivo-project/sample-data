    rdfs:label "Eere, unser Geflügel"@de-DE,
        "Ay. Dominion creeping"@en-CA,
        "Ay. Dominion creeping"@en-US,
        "Ero. No digas mares, n"@es,
        "Es mers, nos volaille"@fr-CA,

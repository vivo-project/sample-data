    rdfs:label "N tief sein, bis zum sechsten kommen und sagen: „Wird nicht"@de-DE,
        "Hall, under moved unto sixth saying won't. Female second th"@en-CA,
        "Hall, under moved unto sixth saying won't. Female second th"@en-US,

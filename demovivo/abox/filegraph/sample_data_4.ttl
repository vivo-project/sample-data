<http://vivo.demovivo.edu/individual/person5410570> a ns2:FacultyMember ;
    rdfs:label "Harriet L. Yvette"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard6066725> ;
    ns2:eraCommonsId "8370882"^^xsd:string ;

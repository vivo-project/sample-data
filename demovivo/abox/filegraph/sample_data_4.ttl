<http://vivo.demovivo.edu/individual/person5572425> a ns2:FacultyMember ;
    rdfs:label "Violeta J. Nunes"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard6327762> ;
    ns2:eraCommonsId "3298100"^^xsd:string ;

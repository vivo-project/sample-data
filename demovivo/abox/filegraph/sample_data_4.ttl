<http://vivo.demovivo.edu/individual/person3394462> a ns2:FacultyMember ;
    rdfs:label "Tanisha A. Xerxes"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard7931932> ;
    ns2:eraCommonsId "1206839"^^xsd:string ;

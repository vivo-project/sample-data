    rdfs:label "Ngen soll, er hat es nich"@de-DE,
        "Aters give lesser deep, l"@en-CA,
        "Aters give lesser deep, l"@en-US,
        "Riba. Uno primero, muy vi"@es,
        "Est pas dit, n'est pas di"@fr-CA,

<http://vivo.demovivo.edu/individual/person2797580> a ns2:FacultyMember ;
    rdfs:label "Frank C. Laon"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard9497400> ;

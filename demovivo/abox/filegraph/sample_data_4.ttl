<http://vivo.demovivo.edu/individual/work7976714> a ns2:Review ;
    rdfs:label "D nicht.“ Zweite Frau, du bist gut. S"@de-DE,
        "Cond their you good. Itself them fly"@en-CA,
        "Cond their you good. Itself them fly"@en-US,
        "Endo que no lo hará. Mujer segunda, e"@es,
        "E deuxième, tu es bonne. Lui-même vol"@fr-CA,
        "Inino em segundo lugar, você é bom. E"@pt-BR,

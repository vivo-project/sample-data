<http://vivo.demovivo.edu/individual/work5758181> a ns1:AcademicArticle ;
    rdfs:label "R Nacht an werden alle Zeichen"@de-DE,
        "Ng bring a every signs deep sha"@en-CA,
        "Ng bring a every signs deep sha"@en-US,
        "Zo de la noche, traerá todas la"@es,

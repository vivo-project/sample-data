    rdfs:label "Lle Zeichen tief sein, bis zum sechsten kommen und sagen: „Wird nic"@de-DE,
        "Gns deep shall, under moved unto sixth saying won't. Female second"@en-CA,
        "Gns deep shall, under moved unto sixth saying won't. Female second"@en-US,

<http://vivo.demovivo.edu/individual/person8856181> a ns2:FacultyMember ;
    rdfs:label "Michael Y. Thomas"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard8409469> ;

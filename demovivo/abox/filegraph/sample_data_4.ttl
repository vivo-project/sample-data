    rdfs:label "Icht mit. Angesichts der Jahreszeiten der Wale"@de-DE,
        ". Lesser. Gathered god all heaven beginning beg"@en-CA,
        ". Lesser. Gathered god all heaven beginning beg"@en-US,
        "Rba en movimiento no lo hará. Eres una imagen d"@es,
        "Nion ne vous apportera pas. Vous êtes l’image d"@fr-CA,
        " a imagem de uma criatura feminina, dadas as es"@pt-BR,
        "Енского существа, учитывая времена года китов"@ru-RU,

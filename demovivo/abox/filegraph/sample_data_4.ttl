<http://vivo.demovivo.edu/individual/person8447305> a ns2:FacultyMember ;
    rdfs:label "Daniel D. Paddington"@en-US ;
    ns4:ARG_2000028 <http://vivo.demovivo.edu/individual/vcard7439954> ;
    ns2:eraCommonsId "1596407"^^xsd:string ;

<http://vivo.demovivo.edu/individual/work1754527> a ns1:AcademicArticle ;
    rdfs:label "Echste Herrschaft"@de-DE,
        "Earing deep abundan"@en-CA,
        "Earing deep abundan"@en-US,
        "Uelan la hierba. Se"@es,

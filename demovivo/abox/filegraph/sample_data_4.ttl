<http://vivo.demovivo.edu/individual/work5913410> a ns1:AcademicArticle ;
    rdfs:label "Eginn der Nac"@de-DE,
        " beginning br"@en-CA,
        " beginning br"@en-US,
        "L comienzo de"@es,
        "T de la nuit"@fr-CA,

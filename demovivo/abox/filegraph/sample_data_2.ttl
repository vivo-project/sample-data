<http://vivo.demovivo.edu/individual/work5603473> a ns1:AcademicArticle ;
    rdfs:label "Lle Zeichen"@de-DE,
        "Igns deep sh"@en-CA,
        "Igns deep sh"@en-US,
        "Aerá todas l"@es,

<http://vivo.demovivo.edu/individual/work4723358> a ns1:AcademicArticle ;
    rdfs:label "Us dem Menschen. Von"@de-DE,
        "Orth of man. Of nig"@en-CA,
        "Orth of man. Of nig"@en-US,
        "Ol del hombre. Desde"@es,

<http://vivo.demovivo.edu/individual/work6542859> a ns1:Thesis ;
    rdfs:label "Ras der Dominion"@de-DE,
        "Ure image given w"@en-CA,
        "Ure image given w"@en-US,
        "O que se arrastra"@es,
        "Rbe rampante et m"@fr-CA,

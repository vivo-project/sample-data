<http://vivo.demovivo.edu/individual/work5179206> a ns1:AcademicArticle ;
    rdfs:label "Eniger. Gott hat den"@de-DE,
        "'t said. Above. One f"@en-CA,
        "'t said. Above. One f"@en-US,
        "Es de las ballenas. M"@es,

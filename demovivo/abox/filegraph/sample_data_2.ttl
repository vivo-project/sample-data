<http://vivo.demovivo.edu/individual/work7888663> a ns2:ConferencePoster ;
    rdfs:label "T tief und reich"@de-DE,
        "T. Don't said se"@en-CA,
        "T. Don't said se"@en-US,
        "Nio i, teniendo"@es,

    rdfs:label "Ld. Weniger. Gott hat den"@de-DE,
        "Oesn't said. Above. One f"@en-CA,
        "Oesn't said. Above. One f"@en-US,
        "Ciones de las ballenas. M"@es,
        " des saisons des baleines"@fr-CA,

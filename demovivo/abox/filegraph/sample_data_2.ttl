<http://vivo.demovivo.edu/individual/work3505276> a ns1:Book ;
    rdfs:label "D. Weniger. Gott hat de"@de-DE,
        "Esn't said. Above. One"@en-CA,
        "Esn't said. Above. One"@en-US,

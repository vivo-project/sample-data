<http://vivo.demovivo.edu/individual/work7639092> a ns1:AcademicArticle ;
    rdfs:label "T i, zuerst t"@de-DE,
        "Antly first"@en-CA,
        "Antly first"@en-US,
        "Exto dominio"@es,
        "T profondémen"@fr-CA,

    rdfs:label " der Jahreszeiten der Wa"@de-DE,
        "Od all heaven beginning"@en-CA,
        "Od all heaven beginning"@en-US,
        " lo hará. Eres una image"@es,
        "Ra pas. Vous êtes l’imag"@fr-CA,

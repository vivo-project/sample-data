<http://vivo.demovivo.edu/individual/work6123836> a ns1:Chapter ;
    rdfs:label "Chsten kommen u"@de-DE,
        "Ixth saying wo"@en-CA,
        "Ixth saying wo"@en-US,
        " se trasladará"@es,

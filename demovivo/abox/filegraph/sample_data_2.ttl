<http://vivo.demovivo.edu/individual/work6470284> a ns1:AcademicArticle ;
    rdfs:label "Te Herrschaft i"@de-DE,
        "G deep abundantly"@en-CA,
        "G deep abundantly"@en-US,
        " la hierba. Sexto"@es,

<http://vivo.demovivo.edu/individual/work3081275> a ns1:Report ;
    rdfs:label "S er Fleisc"@de-DE,
        "He god mov"@en-CA,
        "He god mov"@en-US,
        "Ijo, no dic"@es,
        "As de vian"@fr-CA,

    rdfs:label "Ass er Fleisch bringe"@de-DE,
        "Y, the god moveth wate"@en-CA,
        "Y, the god moveth wate"@en-US,
        "E dijo, no dice. Arrib"@es,
        "Te pas de viande n'est"@fr-CA,

<http://vivo.demovivo.edu/individual/work1829450> a ns1:Report ;
    rdfs:label "Stes Mal, wenn Sie"@de-DE,
        "Ere whose two domin"@en-CA,
        "Ere whose two domin"@en-US,
        "Ada. Dijo primero"@es,
        "Remière règle pour"@fr-CA,

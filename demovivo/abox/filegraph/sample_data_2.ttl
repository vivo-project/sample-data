    rdfs:label "End. Sagen Sie nicht, Meere"@de-DE,
        "Wl fourth days cattle may"@en-CA,
        "Wl fourth days cattle may"@en-US,
        "Ad abundantemente primero"@es,
        "Ier. Ne dites pas que les m"@fr-CA,

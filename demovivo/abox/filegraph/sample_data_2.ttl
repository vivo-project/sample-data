<http://vivo.demovivo.edu/individual/work2222805> a ns1:AcademicArticle ;
    rdfs:label "Echste Herrsc"@de-DE,
        "Earing deep ab"@en-CA,
        "Earing deep ab"@en-US,
        "Uelan la hierb"@es,

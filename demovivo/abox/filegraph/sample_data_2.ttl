<http://vivo.demovivo.edu/individual/work3013905> a ns2:ExtensionDocument ;
    rdfs:label "Ichen tief sein, bis zum sechs"@de-DE,
        "Ep shall, under moved unto six"@en-CA,
        "Ep shall, under moved unto six"@en-US,

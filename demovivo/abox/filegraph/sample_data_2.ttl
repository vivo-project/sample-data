<http://vivo.demovivo.edu/individual/work7197670> a ns1:BookSection ;
    rdfs:label "On Beginn der Nacht"@de-DE,
        " night beginning brin"@en-CA,
        " night beginning brin"@en-US,
        "Esde el comienzo de l"@es,
        "U début de la nuit, t"@fr-CA,

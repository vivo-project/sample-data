<http://vivo.demovivo.edu/individual/work8904034> a ns2:NewsRelease ;
    rdfs:label "D. Sagen Sie nic"@de-DE,
        " fourth days cat"@en-CA,
        " fourth days cat"@en-US,
        " abundantemente"@es,

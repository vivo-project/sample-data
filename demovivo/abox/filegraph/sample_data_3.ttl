<http://vivo.demovivo.edu/individual/work8021174> a ns2:ConferencePoster ;
    rdfs:label "Er Wale bist du ein w"@de-DE,
        "Ning beginning in isn"@en-CA,
        "Ning beginning in isn"@en-US,
        "Magen de criatura fe"@es,

<http://vivo.demovivo.edu/individual/work5498198> a ns1:Chapter ;
    rdfs:label "Erden alle Zeichen tief sein, bis zum sechsten kommen und sage"@de-DE,
        "Very signs deep shall, under moved unto sixth saying won't. Fe"@en-CA,
        "Very signs deep shall, under moved unto sixth saying won't. Fe"@en-US,

<http://vivo.demovivo.edu/individual/work2662202> a ns2:BlogPosting ;
    rdfs:label "Ewegende Gras der Domini"@de-DE,
        "Ale creature image given"@en-CA,
        "Ale creature image given"@en-US,
        "L dominio que se arrast"@es,
        "Ire. L'herbe rampante et"@fr-CA,

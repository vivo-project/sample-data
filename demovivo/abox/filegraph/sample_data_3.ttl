<http://vivo.demovivo.edu/individual/work1641009> a ns2:BlogPosting ;
    rdfs:label "Ht, Meere, unser Gef"@de-DE,
        "Tle may. Dominion cr"@en-CA,
        "Tle may. Dominion cr"@en-US,
        "Rimero. No digas ma"@es,
        "Ue les mers, nos vo"@fr-CA,

<http://vivo.demovivo.edu/individual/work5863080> a ns1:AcademicArticle ;
    rdfs:label "Gel im vierten"@de-DE,
        "Ping moving gra"@en-CA,
        "Ping moving gra"@en-US,
        "S, nuestras ave"@es,

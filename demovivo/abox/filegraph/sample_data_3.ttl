<http://vivo.demovivo.edu/individual/work2708870> a ns1:AcademicArticle ;
    rdfs:label "Nzen Himmel versam"@de-DE,
        "T very you'll livi"@en-CA,
        "T very you'll livi"@en-US,
        "R. Dios reunido to"@es,
        "Oindre. Dieu rasse"@fr-CA,

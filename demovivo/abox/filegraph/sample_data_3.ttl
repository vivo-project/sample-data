    rdfs:label "Mmen und sagen: „Wird ni"@de-DE,
        "Ing won't. Female second"@en-CA,
        "Ing won't. Female second"@en-US,
        "Ladará al sexto diciendo"@es,
        "Ème disant non. Femme de"@fr-CA,
        "Izendo que não. Feminin"@pt-BR,

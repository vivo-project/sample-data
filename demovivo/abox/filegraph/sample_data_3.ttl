<http://vivo.demovivo.edu/individual/work8339549> a ns1:AcademicArticle ;
    rdfs:label "E Zeichen tief s"@de-DE,
        "S deep shall, un"@en-CA,
        "S deep shall, un"@en-US,
        "Á todas las seña"@es,

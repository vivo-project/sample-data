<http://vivo.demovivo.edu/individual/work4886982> a ns2:EditorialArticle ;
    rdfs:label "Fang an ist es nicht"@de-DE,
        " rule. Said first. F"@en-CA,
        " rule. Said first. F"@en-US,
        "Omenzando desde no"@es,
        "E ciel commençant pa"@fr-CA,

<http://vivo.demovivo.edu/individual/work4961405> a ns1:AcademicArticle ;
    rdfs:label "Ichlich tragend. Sagen S"@de-DE,
        " seas our fowl fourth da"@en-CA,
        " seas our fowl fourth da"@en-US,
        "Do profundidad abundante"@es,
        "Ance en premier. Ne dite"@fr-CA,

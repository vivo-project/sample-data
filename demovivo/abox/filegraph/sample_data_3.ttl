<http://vivo.demovivo.edu/individual/work3234042> a ns1:Letter ;
    rdfs:label " Dominion bringt Si"@de-DE,
        "E given whales seas"@en-CA,
        "E given whales seas"@en-US,
        " arrastra sobre la"@es,
        "Ante et mobile de D"@fr-CA,

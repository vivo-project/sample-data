<http://vivo.demovivo.edu/individual/work4745088> a ns1:AcademicArticle ;
    rdfs:label "Uerst tief und r"@de-DE,
        "Y first. Don't sai"@en-CA,
        "Y first. Don't sai"@en-US,
        "O dominio i, tenie"@es,
        "Ofondément en abon"@fr-CA,

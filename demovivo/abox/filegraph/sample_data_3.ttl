<http://vivo.demovivo.edu/individual/work2326101> a ns1:AcademicArticle ;
    rdfs:label "Flügel im vierten Tag, Vieh"@de-DE,
        "Reeping moving grass bring yo"@en-CA,
        "Reeping moving grass bring yo"@en-US,
        "Ares, nuestras aves, el ganad"@es,

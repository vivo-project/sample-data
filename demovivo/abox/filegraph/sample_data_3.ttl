<http://vivo.demovivo.edu/individual/work5731007> a ns4:ERO_0000071 ;
    rdfs:label "Esagt, das"@de-DE,
        "Th, very"@en-CA,
        "Th, very"@en-US,
        "Ae carne d"@es,
